    atlasWidth: 1024
    atlasHeight: 1024
    characterSetSelectionMode: 7
    characterSequence: "1. \uAE30\uBCF8\uC870\uC791 : \uB9C8\uC6B0\uC2A4 \uC6B0\uD074\uB9AD\uC73C\uB85C
      \uC774\uB3D9\uC774 \uAC00\uB2A5\uD569\uB2C8\uB2E4 2. \uAE30\uBCF8\uACF5\uACA9
      : \uC2A4\uD398\uC774\uC2A4\uBC14\uB85C \uC801\uC744 \uBC00\uCCD0\uB0BC\uC218\uC788\uC2B5\uB2C8\uB2E4.
      \uC801\uC911 \uC2DC \uD0D1\uC2B9 \uAC8C\uC774\uC9C0\uB97C \uD68D\uB4DD\uD569\uB2C8\uB2E4
      3. \uAC01\uC885\uC81C\uB2E8 : \uAC01\uC885 \uC81C\uB2E8\uC5D0 \uADFC\uCC98\uC5D0\uC11C
      \uC77C\uC815 \uC2DC\uAC04 \uBA38\uBB34\uB974\uBA74 \uC774\uB85C\uC6B4 \uD6A8\uACFC\uB97C
      \uC5BB\uC2B5\uB2C8\uB2E4 4. \uCEE4\uC11C\uD0D1\uC2B9: e\uD0A4\uB97C \uB20C\uB7EC\uC11C
      \uCEE4\uC11C\uC5D0 \uD0D1\uC2B9\uC774 \uAC00\uB2A5\uD569\uB2C8\uB2E4, \uC774\uC81C
      \uC790\uB3D9\uC73C\uB85C \uC2A4\uD0AC\uC774 \uBC1C\uB3D9\uB429\uB2C8\uB2E4.
      5. \uC624\uBC84\uB4DC\uB77C\uC774\uBE0C : \uC774\uB3D9\uC740 \uB9C8\uC6B0\uC2A4
      \uCEE4\uC11C\uB97C \uB530\uB77C\uAC11\uB2C8\uB2E4, \uAC8C\uC774\uC9C0\uAC00
      0\uC774\uB418\uBA74 \uCEE4\uC11C\uC5D0\uC11C \uB5A8\uC5B4\uC9D1\uB2C8\uB2E4"
